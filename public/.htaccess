# Rewrite rules para rutas dinámicas de eventos y manejo de 404
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirigir todas las rutas /eventos/* a /eventos/dynamic/
  # Esto permite que eventos nuevos funcionen sin rebuild
  # El componente EventDetail extraerá el slug de la URL y manejará la carga dinámica
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^eventos/(.+)$ /eventos/dynamic/ [L]
  
  # Para todas las demás rutas que no existen, mostrar la página 404 de Astro
  # Esto debe ir después de las reglas específicas de eventos
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteCond %{REQUEST_URI} !^/eventos/
  RewriteRule ^(.*)$ /404.html [L]
</IfModule>

# Configurar ErrorDocument para mostrar la página 404 de Astro
ErrorDocument 404 /404.html