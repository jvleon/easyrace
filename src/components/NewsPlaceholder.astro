---
const articles = [
  {
    title: 'Nueva temporada de ciclismo de ruta 2026',
    excerpt: 'Conoce los eventos mas importantes de ciclismo de ruta que se llevaran a cabo en el sureste mexicano.',
    date: '10 Mar 2026',
    category: 'Ciclismo',
  },
  {
    title: 'Tips para tu primera carrera de 10K',
    excerpt: 'Guia completa para prepararte y disfrutar tu primera carrera de 10 kilometros.',
    date: '05 Mar 2026',
    category: 'Running',
  },
  {
    title: 'EasyRace se expande a nuevos estados',
    excerpt: 'La plataforma ahora esta disponible para organizadores en toda la republica mexicana.',
    date: '28 Feb 2026',
    category: 'Plataforma',
  },
];
---

<!-- TODO: Connect to CMS/Supabase when ready -->
<section id="noticias" class="py-16 md:py-24 bg-white-pure/5" data-section-status="placeholder">
  <div class="container mx-auto px-4">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-white-pure mb-2">Noticias</h2>
        <p class="text-white-pure/60">Lo ultimo del mundo deportivo</p>
      </div>
      <a href="/noticias" class="hidden md:inline-flex items-center gap-2 text-orange-primary hover:text-red-fire transition-colors font-medium text-sm">
        Ver todas
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {articles.map((article) => (
        <div class="rounded-lg border border-white-pure/10 bg-black-asphalt/50 overflow-hidden hover:border-orange-primary/30 transition-colors">
          <!-- Placeholder image area -->
          <div class="h-40 bg-gradient-to-br from-white-pure/10 to-white-pure/5 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white-pure/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-orange-primary text-xs font-medium">{article.category}</span>
              <span class="text-white-pure/40 text-xs">{article.date}</span>
            </div>
            <h3 class="text-white-pure font-bold text-base mb-2">{article.title}</h3>
            <p class="text-white-pure/50 text-sm line-clamp-2">{article.excerpt}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
