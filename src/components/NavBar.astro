---
import logoHorizontal from '../assets/logo_horizontal.png';
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-black-asphalt/90 backdrop-blur-md">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a id="logo-link" href="/" class="flex items-center hover:opacity-80 transition-opacity">
        <img
          src={logoHorizontal.src}
          alt="EasyRace Logo"
          class="w-[150px] md:w-[180px] h-auto"
        />
      </a>

      <!-- Desktop Nav Links -->
      <div id="nav-links" class="hidden md:flex items-center gap-8">
        <a href="/#que-hace-easyrace" class="text-white-pure/80 hover:text-orange-primary transition-colors text-sm font-medium">
          ¿Qué hace EasyRace?
        </a>
        <a href="/eventos" class="text-white-pure/80 hover:text-orange-primary transition-colors text-sm font-medium">
          Eventos
        </a>
        <a href="/noticias" class="text-white-pure/80 hover:text-orange-primary transition-colors text-sm font-medium">
          Noticias
        </a>
        <a href="/blog" class="text-white-pure/80 hover:text-orange-primary transition-colors text-sm font-medium">
          Blog
        </a>
        <a href="/contacto" class="text-white-pure/80 hover:text-orange-primary transition-colors text-sm font-medium">
          Contacto
        </a>
      </div>

      <!-- Right side: Login + Mobile hamburger -->
      <div id="nav-actions" class="flex items-center gap-3">
        <!-- Login button -->
        <a
          href="https://manager.easyrace.com.mx"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:flex items-center gap-2 px-4 py-2 bg-orange-primary hover:bg-red-fire text-white-pure rounded-lg transition-colors text-sm font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Iniciar Sesion
        </a>

        <!-- Mobile login icon -->
        <a
          href="https://manager.easyrace.com.mx"
          target="_blank"
          rel="noopener noreferrer"
          class="md:hidden flex items-center justify-center w-10 h-10 bg-orange-primary hover:bg-red-fire text-white-pure rounded-lg transition-colors"
          aria-label="Login"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>

        <!-- Hamburger button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-10 h-10 text-white-pure hover:text-orange-primary transition-colors"
          aria-label="Menu"
        >
          <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-white-pure/10">
      <div class="flex flex-col gap-4 pt-4">
        <a href="/#que-hace-easyrace" class="text-white-pure/80 hover:text-orange-primary transition-colors text-base font-medium">
          ¿Qué hace EasyRace?
        </a>
        <a href="/eventos" class="text-white-pure/80 hover:text-orange-primary transition-colors text-base font-medium">
          Eventos
        </a>
        <a href="/noticias" class="text-white-pure/80 hover:text-orange-primary transition-colors text-base font-medium">
          Noticias
        </a>
        <a href="/blog" class="text-white-pure/80 hover:text-orange-primary transition-colors text-base font-medium">
          Blog
        </a>
        <a href="/contacto" class="text-white-pure/80 hover:text-orange-primary transition-colors text-base font-medium">
          Contacto
        </a>
      </div>
    </div>
  </nav>
</header>

<!-- Spacer to prevent content from hiding behind fixed nav -->
<div class="h-[72px]"></div>

<script>
  // Scroll detection: add background on scroll
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          navbar.classList.add('nav-scrolled');
        } else {
          navbar.classList.remove('nav-scrolled');
        }
      },
      { threshold: 0, rootMargin: '0px' }
    );

    // Create a sentinel element at the top of the page
    const sentinel = document.createElement('div');
    sentinel.style.position = 'absolute';
    sentinel.style.top = '0';
    sentinel.style.height = '1px';
    sentinel.style.width = '1px';
    document.body.prepend(sentinel);
    observer.observe(sentinel);

    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    menuBtn?.addEventListener('click', () => {
      const isOpen = !mobileMenu?.classList.contains('hidden');
      mobileMenu?.classList.toggle('hidden');
      hamburgerIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
      // Add background when menu is open
      if (!isOpen) {
        navbar.classList.add('nav-scrolled');
      }
    });

    // Close mobile menu on link click
    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });
  }

  // Demo logo-disabling logic (preserved from Header.astro)
  function shouldDisableLogoLink(): boolean {
    const hostname = window.location.hostname;
    const pathname = window.location.pathname;
    const isDemo =
      hostname.startsWith('demo.') ||
      hostname === 'demo.easyrace.com.mx' ||
      hostname === 'localhost' ||
      hostname === '127.0.0.1';
    const isEventPage = pathname.startsWith('/eventos/');
    return isDemo && isEventPage;
  }

  document.addEventListener('DOMContentLoaded', () => {
    initNavbar();

    if (shouldDisableLogoLink()) {
      // Deshabilitar el link del logo
      const logoLink = document.getElementById('logo-link');
      if (logoLink) {
        const span = document.createElement('span');
        span.className = 'flex items-center';
        span.innerHTML = logoLink.innerHTML;
        logoLink.replaceWith(span);
      }

      // Ocultar links de navegación y botones de acción
      document.getElementById('nav-links')?.style.setProperty('display', 'none');
      document.getElementById('nav-actions')?.style.setProperty('display', 'none');
    }
  });
</script>
