---
import logoHorizontal from '../assets/logo_horizontal.png';
---

<header class="bg-white-pure shadow-md sticky top-0 z-50" style="scroll-margin-top: 0;">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo: siempre renderiza como link, el script del cliente lo deshabilita en demo/localhost + página de evento -->
      <a id="logo-link" href="/" class="flex items-center hover:opacity-80 transition-opacity">
        <img
          src={logoHorizontal.src}
          alt="EasyRace Logo"
          class="w-[180px] h-auto"
        />
      </a>

      <!-- Botón de Login -->
      <a
        href="https://manager.easyrace.com.mx"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center w-10 h-10 md:w-12 md:h-12 bg-orange-primary hover:bg-red-fire text-white-pure rounded-lg transition-colors"
        aria-label="Login"
        title="Login"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 md:h-6 md:w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          />
        </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  // Deshabilitar el link del logo solo en demo/localhost cuando estamos en página de evento
  function shouldDisableLogoLink(): boolean {
    const hostname = window.location.hostname;
    const pathname = window.location.pathname;
    
    const isDemo = 
      hostname.startsWith('demo.') ||
      hostname === 'demo.easyrace.com.mx' ||
      hostname === 'localhost' ||
      hostname === '127.0.0.1';
    
    const isEventPage = pathname.startsWith('/eventos/');
    
    return isDemo && isEventPage;
  }

  // Ejecutar cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    if (shouldDisableLogoLink()) {
      const logoLink = document.getElementById('logo-link');
      if (logoLink) {
        // Crear un span con el mismo contenido y clases
        const span = document.createElement('span');
        span.className = 'flex items-center';
        span.innerHTML = logoLink.innerHTML;
        logoLink.replaceWith(span);
      }
    }
  });
</script>

