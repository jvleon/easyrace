---
const upcomingEvents = [
  { date: '15 Abr 2026', name: 'Gran Fondo Tabasco', location: 'Villahermosa, Tabasco', type: 'Ciclismo' },
  { date: '22 Abr 2026', name: 'Carrera Nocturna 10K', location: 'Merida, Yucatan', type: 'Running' },
  { date: '06 May 2026', name: 'Triatlon del Sureste', location: 'Cancun, Quintana Roo', type: 'Triatlon' },
  { date: '20 May 2026', name: 'MTB Challenge Sierra', location: 'San Cristobal, Chiapas', type: 'Ciclismo' },
];
---

<!-- TODO: Connect to Supabase when ready -->
<section id="proximos-eventos" class="py-16 md:py-24 bg-white-pure/5" data-section-status="placeholder">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-white-pure mb-2">
      Proximos Eventos
    </h2>
    <p class="text-white-pure/60 mb-10">Calendario de eventos deportivos</p>

    <div class="space-y-4">
      {upcomingEvents.map((event) => (
        <div class="flex items-center gap-4 md:gap-6 p-4 md:p-5 rounded-lg border border-white-pure/10 hover:border-orange-primary/30 transition-colors bg-black-asphalt/50">
          <!-- Date -->
          <div class="flex-shrink-0 w-16 md:w-20 text-center">
            <div class="text-orange-primary font-bold text-sm md:text-base">{event.date.split(' ')[0]}</div>
            <div class="text-white-pure/60 text-xs uppercase">{event.date.split(' ')[1]} {event.date.split(' ')[2]}</div>
          </div>

          <!-- Divider -->
          <div class="w-px h-10 bg-white-pure/20 flex-shrink-0"></div>

          <!-- Info -->
          <div class="flex-1 min-w-0">
            <h3 class="text-white-pure font-semibold text-base md:text-lg truncate">{event.name}</h3>
            <p class="text-white-pure/50 text-sm truncate">{event.location}</p>
          </div>

          <!-- Type badge -->
          <span class="hidden md:inline-block px-3 py-1 bg-white-pure/10 text-white-pure/70 text-xs rounded-full flex-shrink-0">
            {event.type}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
