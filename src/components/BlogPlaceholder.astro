---
const posts = [
  {
    title: 'Cómo organizar tu primera carrera de 5K paso a paso',
    excerpt: 'Desde el permiso municipal hasta la logística del agua y la meta. Una guía práctica para organizadores novatos.',
    date: '12 Mar 2026',
    category: 'Guías',
    readTime: '8 min',
  },
  {
    title: 'Por qué el registro digital reduce un 60% el trabajo administrativo',
    excerpt: 'Comparativa real entre organizadores que usaban Excel y los que migraron a una plataforma de registro automatizado.',
    date: '05 Mar 2026',
    category: 'Plataforma',
    readTime: '5 min',
  },
  {
    title: 'El dorsal perfecto: diseño, materiales y numeración automática',
    excerpt: 'Todo lo que necesitas saber sobre dorsales para tu evento: desde el diseño hasta cómo EasyRace los asigna automáticamente.',
    date: '25 Feb 2026',
    category: 'Tips',
    readTime: '6 min',
  },
];
---

<!-- TODO: Connect to CMS when ready -->
<section id="blog" class="py-16 md:py-24 bg-black-asphalt" data-section-status="placeholder">
  <div class="container mx-auto px-4">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-orange-primary text-sm font-medium uppercase tracking-widest mb-2">Blog</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white-pure">Para Organizadores</h2>
        <p class="text-white-pure/60 mt-2">Guías, tips y recursos para llevar tu evento al siguiente nivel</p>
      </div>
      <a href="/blog" class="hidden md:inline-flex items-center gap-2 text-orange-primary hover:text-red-fire transition-colors font-medium text-sm">
        Ver todos
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <article class="rounded-xl border border-white-pure/10 bg-white-pure/5 overflow-hidden hover:border-orange-primary/30 transition-colors group">
          <!-- Placeholder image -->
          <div class="h-44 bg-gradient-to-br from-white-pure/10 to-white-pure/5 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white-pure/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-orange-primary text-xs font-medium">{post.category}</span>
              <span class="text-white-pure/30 text-xs">·</span>
              <span class="text-white-pure/40 text-xs">{post.readTime} lectura</span>
              <span class="text-white-pure/30 text-xs">·</span>
              <span class="text-white-pure/40 text-xs">{post.date}</span>
            </div>
            <h3 class="text-white-pure font-bold text-base mb-2 group-hover:text-orange-primary transition-colors leading-snug">
              {post.title}
            </h3>
            <p class="text-white-pure/50 text-sm line-clamp-2">{post.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
