---
const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>`,
    title: 'Registro Digital Automatizado',
    desc: 'Formularios configurables por evento: categorías, distancias, datos médicos, talla de kit. Sin papel, sin caos.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>`,
    title: 'Asignación de Dorsales',
    desc: 'Los números de dorsal se asignan automáticamente según la categoría y el orden de registro. Cero trabajo manual.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: 'Validación de Comprobantes',
    desc: 'Los participantes suben su comprobante de pago directo en la plataforma. Tú confirmas con un clic desde el panel de organizador.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    title: 'Base de Datos de Competidores',
    desc: 'Historial completo por participante: datos personales, tipo de sangre, contacto de emergencia y club. Disponible al instante para el organizador.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    title: 'Galería y Contenido del Evento',
    desc: 'Publica banners, rutas de Strava, galería de fotos y kits desde el panel. Los participantes ven todo en una sola página.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2a2 2 0 002 2zM12 11a4 4 0 100-8 4 4 0 000 8z" /></svg>`,
    title: 'Experiencia Profesional para el Participante',
    desc: 'Página de evento con cuenta regresiva, descripción, reglamento, categorías y mapa. Tu evento se ve como uno de clase mundial.',
  },
];
---

<section id="que-hace-easyrace" class="py-16 md:py-24 bg-white-pure/5">
  <div class="container mx-auto px-4">

    <!-- Header -->
    <div class="max-w-2xl mb-14">
      <p class="text-orange-primary text-sm font-medium uppercase tracking-widest mb-3">La Plataforma</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white-pure mb-4 leading-tight">
        Todo lo que necesitas para<br class="hidden md:block" /> correr un evento profesional
      </h2>
      <p class="text-white-pure/60 text-lg">
        EasyRace automatiza la parte operativa del registro para que tú te enfoques en hacer un gran evento.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <div class="group p-6 rounded-xl border border-white-pure/10 bg-black-asphalt/60 hover:border-orange-primary/40 hover:bg-black-asphalt transition-all duration-300">
          <div class="w-12 h-12 rounded-lg bg-orange-primary/10 flex items-center justify-center text-orange-primary mb-4 group-hover:bg-orange-primary/20 transition-colors">
            <Fragment set:html={f.icon} />
          </div>
          <h3 class="text-white-pure font-bold text-lg mb-2">{f.title}</h3>
          <p class="text-white-pure/55 text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <a
        href="https://wa.me/5219932069861"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-orange-primary hover:bg-red-fire text-white-pure font-semibold rounded-lg transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Quiero poner mi evento
      </a>
      <a
        href="/eventos"
        class="inline-flex items-center gap-2 text-white-pure/60 hover:text-white-pure transition-colors text-sm"
      >
        Ver eventos activos
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>
