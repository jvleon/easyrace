---
const partners = [
  'Federacion de Ciclismo',
  'Running MX',
  'Deportes Tabasco',
  'TriMexico',
  'Bike Store Pro',
  'Nutricion Deportiva',
];
---

<!-- TODO: Connect to Supabase when ready -->
<section id="alianzas" class="py-16 md:py-24 bg-black-asphalt" data-section-status="placeholder">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-white-pure mb-2 text-center">
      Alianzas Estrategicas
    </h2>
    <p class="text-white-pure/60 mb-10 text-center">Organizaciones que confian en EasyRace</p>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {partners.map((partner) => (
        <div class="aspect-[3/2] rounded-lg border border-white-pure/10 bg-white-pure/5 flex items-center justify-center hover:border-orange-primary/30 transition-colors">
          <span class="text-white-pure/30 text-sm font-medium text-center px-3">{partner}</span>
        </div>
      ))}
    </div>
  </div>
</section>
