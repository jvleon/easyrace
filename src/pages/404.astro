---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Página no encontrada - EasyRace" />
    <title>404 - Página no encontrada - EasyRace</title>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <Header />
    <main class="container mx-auto px-4 py-8 md:py-12 flex-1 flex items-center justify-center">
      <div class="text-center max-w-2xl mx-auto">
        <h1 class="text-6xl md:text-8xl font-bold text-orange-primary mb-4">
          404
        </h1>
        <h2 class="text-2xl md:text-3xl font-bold text-white-pure mb-4">
          Página no encontrada
        </h2>
        <p class="text-white-pure/70 text-lg mb-8">
          Lo sentimos, la página que estás buscando no existe o ha sido movida.
        </p>
        <a
          href="/"
          class="inline-block px-6 py-3 bg-orange-primary hover:bg-red-fire text-white-pure rounded-lg font-semibold transition-colors"
        >
          Volver al inicio
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>

