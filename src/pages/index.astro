---
import EventsList from '../components/EventsList';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestion de eventos deportivos" />
    <title>EasyRace - Eventos Deportivos</title>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H98RYPYQCQ');
    </script>
	<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>
</head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <Header />
    <main class="container mx-auto px-4 pt-4 pb-8 md:pt-6 md:pb-12 flex-1">
      <header class="mb-8 md:mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white-pure mb-4">
          Eventos Deportivos
        </h1>
        <p class="text-white-pure/70 text-lg max-w-2xl mx-auto">
          Descubre y participa en los mejores eventos deportivos
        </p>
      </header>

      <EventsList client:load />
    </main>
    <Footer />
	</body>
</html>
