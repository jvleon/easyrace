---
import NavBar from '../components/NavBar.astro';
import HeroSection from '../components/HeroSection.astro';
import WhatIsEasyRace from '../components/WhatIsEasyRace.astro';
import FeaturedEvents from '../components/FeaturedEvents';
import NewsPlaceholder from '../components/NewsPlaceholder.astro';
import BlogPlaceholder from '../components/BlogPlaceholder.astro';
import SentryInit from '../components/SentryInit';
import { VersionCheckModal } from '../components/VersionCheckModal';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
    <meta name="keywords" content="EasyRace, eventos deportivos, eventos, deportivos, eventos online, eventos en linea, registro carrera, registro running, registro ciclismo, registro triatlon, formulario para evento deportivo" />
    <meta name="author" content="Coderbox Software Solutions" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Staging/Demo guard: bloquea analytics e inyecta noindex -->
    <script is:inline src="/staging-guard.js"></script>
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestion de eventos deportivos. Profesionaliza tu evento con registro digital, categorias y resultados." />
    <title>EasyRace - Eventos Deportivos</title>

    <!-- Google Fonts: Teko for hero headlines -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Google tag (gtag.js) - No se carga en staging/demo -->
    <script is:inline>
      if (!window.__EASYRACE_BLOCK_ANALYTICS__) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-H98RYPYQCQ');
      }
    </script>

</head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <NavBar />
    <main>
      <HeroSection />
      <WhatIsEasyRace />
      <FeaturedEvents client:load />
      <NewsPlaceholder />
      <BlogPlaceholder />
    </main>
    <Footer />

    <!-- Section reveal on scroll -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var sections = document.querySelectorAll('[data-section-status], section:not(.parallax-section)');
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
            }
          });
        }, { threshold: 0.1 });
        sections.forEach(function(s) {
          if (!s.classList.contains('parallax-section')) {
            s.classList.add('section-reveal');
            observer.observe(s);
          }
        });
      });
    </script>
	</body>
</html>
