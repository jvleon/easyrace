---
import EventsList from '../components/EventsList';
import SentryInit from '../components/SentryInit';
import { VersionCheckModal } from '../components/VersionCheckModal';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
    <meta name="keywords" content="EasyRace, eventos deportivos, eventos, deportivos, eventos online, eventos en linea, registro carrera, registro running, registro ciclismo, registro triatlon, formulario para evento deportivo" />
    <meta name="author" content="Coderbox Software Solutions" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestión de eventos deportivos" />
    <title>EasyRace - Eventos Deportivos</title>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H98RYPYQCQ');
    </script>
    
</head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <Header />
    <main class="container mx-auto px-4 pt-4 pb-8 md:pt-6 md:pb-12 flex-1">
      <header class="mb-8 md:mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white-pure mb-4">
          Próximos eventos
        </h1>

      </header>

      <EventsList client:load />
    </main>
    <Footer />
	</body>
</html>
