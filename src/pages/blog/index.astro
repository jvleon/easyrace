---
import NavBar from '../../components/NavBar.astro';
import SentryInit from '../../components/SentryInit';
import { VersionCheckModal } from '../../components/VersionCheckModal';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const posts = [
  {
    title: 'Cómo organizar tu primera carrera de 5K paso a paso',
    excerpt: 'Desde el permiso municipal hasta la logística del agua y la meta. Una guía práctica para organizadores novatos.',
    date: '12 Mar 2026',
    category: 'Guías',
    readTime: '8 min',
  },
  {
    title: 'Por qué el registro digital reduce un 60% el trabajo administrativo',
    excerpt: 'Comparativa real entre organizadores que usaban Excel y los que migraron a una plataforma de registro automatizado.',
    date: '05 Mar 2026',
    category: 'Plataforma',
    readTime: '5 min',
  },
  {
    title: 'El dorsal perfecto: diseño, materiales y numeración automática',
    excerpt: 'Todo lo que necesitas saber sobre dorsales para tu evento: desde el diseño hasta cómo EasyRace los asigna automáticamente.',
    date: '25 Feb 2026',
    category: 'Tips',
    readTime: '6 min',
  },
  {
    title: 'Cómo definir las categorías de tu evento deportivo',
    excerpt: 'Rangos de edad, categorías especiales, élite y master. Una guía para estructurar correctamente la competencia.',
    date: '18 Feb 2026',
    category: 'Guías',
    readTime: '7 min',
  },
  {
    title: 'Patrocinadores para tu evento: cómo conseguirlos y qué ofrecerles',
    excerpt: 'Estrategias probadas para atraer marcas locales y nacionales a tu carrera o fondo ciclista.',
    date: '10 Feb 2026',
    category: 'Negocios',
    readTime: '9 min',
  },
  {
    title: 'Comunicación con participantes: WhatsApp, email o plataforma',
    excerpt: 'Qué canal usar en cada etapa del evento y cómo automatizar los mensajes clave para reducir dudas frecuentes.',
    date: '03 Feb 2026',
    category: 'Tips',
    readTime: '4 min',
  },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Blog de EasyRace para organizadores de eventos deportivos: guias, tips y recursos para llevar tu evento al siguiente nivel." />
    <title>Blog - EasyRace</title>
    <script is:inline src="/staging-guard.js"></script>
    <script is:inline>
      if (!window.__EASYRACE_BLOCK_ANALYTICS__) {
        var s = document.createElement('script'); s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', 'G-H98RYPYQCQ');
      }
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <NavBar />
    <main class="container mx-auto px-4 pt-4 pb-12 md:pt-6 md:pb-16 flex-1">

      <header class="mb-10 md:mb-14 text-center">
        <p class="text-orange-primary text-sm font-medium uppercase tracking-widest mb-3">Blog</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white-pure mb-4">Para Organizadores</h1>
        <p class="text-white-pure/60 max-w-xl mx-auto">Guias, tips y recursos para llevar tu evento deportivo al siguiente nivel.</p>
      </header>

      <!-- TODO: Connect to CMS when ready -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <article class="rounded-xl border border-white-pure/10 bg-white-pure/5 overflow-hidden hover:border-orange-primary/30 transition-colors group">
            <div class="h-44 bg-gradient-to-br from-white-pure/10 to-white-pure/5 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white-pure/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <div class="p-5">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-orange-primary text-xs font-medium">{post.category}</span>
                <span class="text-white-pure/30 text-xs">·</span>
                <span class="text-white-pure/40 text-xs">{post.readTime} lectura</span>
                <span class="text-white-pure/30 text-xs">·</span>
                <span class="text-white-pure/40 text-xs">{post.date}</span>
              </div>
              <h2 class="text-white-pure font-bold text-base mb-2 group-hover:text-orange-primary transition-colors leading-snug">
                {post.title}
              </h2>
              <p class="text-white-pure/50 text-sm line-clamp-3">{post.excerpt}</p>
            </div>
          </article>
        ))}
      </div>

    </main>
    <Footer />
  </body>
</html>
