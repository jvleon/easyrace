---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import SentryInit from '../components/SentryInit';
import { VersionCheckModal } from '../components/VersionCheckModal';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Contáctanos — EasyRace, la plataforma de gestión de eventos deportivos. Escríbenos por WhatsApp o redes sociales." />
    <title>Contacto - EasyRace</title>
    <script is:inline src="/staging-guard.js"></script>
    <script is:inline>
      if (!window.__EASYRACE_BLOCK_ANALYTICS__) {
        var s = document.createElement('script'); s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', 'G-H98RYPYQCQ');
      }
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <NavBar />
    <main class="container mx-auto px-4 pt-10 pb-16 md:pt-14 md:pb-24 flex-1">

      <header class="mb-12 md:mb-16 text-center">
        <p class="text-orange-primary text-sm font-medium uppercase tracking-widest mb-3">Contacto</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white-pure mb-4">Hablemos</h1>
        <p class="text-white-pure/60 max-w-xl mx-auto">Estamos listos para ayudarte a llevar tu evento al siguiente nivel.</p>
      </header>

      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">

        <!-- Quiénes somos -->
        <div>
          <h2 class="text-2xl font-bold text-white-pure mb-6">Quiénes somos</h2>
          <div class="space-y-4 text-white-pure/70 leading-relaxed">
            <p>
              Somos un equipo con más de 8 años de experiencia en la industria del software y aficionados del ciclismo, running y deportes de resistencia.
            </p>
            <p>
              EasyRace nació porque asistimos a muchos eventos y notamos que faltaba infraestructura digital. Vimos de cerca los problemas del registro manual, la falta de visibilidad para los participantes y la carga operativa que recae sobre los organizadores.
            </p>
            <p>
              Nosotros podemos ayudarte con tu registro, ya sea que quieras tu evento en nuestra plataforma, o quieras <span class="text-white-pure font-medium">marca blanca</span> para darle el estilo completamente personal.
            </p>
            <p>
              EasyRace está pensado para todo tipo de organizadores: desde el club que organiza su primera carrera del año, hasta la empresa o federación que gestiona decenas de eventos. No importa el tamaño, tenemos una solución para ti.
            </p>
            <p>
              Si organizas múltiples eventos al año, representas una federación o buscas una integración más profunda, escríbenos. Estamos abiertos a <span class="text-orange-primary font-medium">alianzas estratégicas</span> con precios y condiciones especiales.
            </p>
          </div>
        </div>

        <!-- Canales de contacto -->
        <div>
          <h2 class="text-2xl font-bold text-white-pure mb-6">Encuéntranos</h2>

          <div class="space-y-4">

            <!-- WhatsApp -->
            <a
              href="https://wa.me/5219932069861"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-xl border border-white-pure/10 bg-white-pure/5 hover:border-green-500/40 hover:bg-green-500/5 transition-all group"
            >
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center group-hover:bg-green-500/20 transition-colors">
                <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                </svg>
              </div>
              <div>
                <p class="text-white-pure font-medium text-sm">WhatsApp</p>
                <p class="text-white-pure/50 text-xs mt-0.5">Escríbenos directo, respondemos rápido</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white-pure/30 ml-auto group-hover:text-green-500/60 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href="https://www.instagram.com/easyrace.mx"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-xl border border-white-pure/10 bg-white-pure/5 hover:border-pink-500/40 hover:bg-pink-500/5 transition-all group"
            >
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-pink-500/10 flex items-center justify-center group-hover:bg-pink-500/20 transition-colors">
                <svg class="w-6 h-6 text-pink-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                </svg>
              </div>
              <div>
                <p class="text-white-pure font-medium text-sm">Instagram</p>
                <p class="text-white-pure/50 text-xs mt-0.5">@easyrace.mx</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white-pure/30 ml-auto group-hover:text-pink-500/60 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Facebook -->
            <a
              href="https://www.facebook.com/profile.php?id=61584670284808"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-xl border border-white-pure/10 bg-white-pure/5 hover:border-blue-500/40 hover:bg-blue-500/5 transition-all group"
            >
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center group-hover:bg-blue-500/20 transition-colors">
                <svg class="w-6 h-6 text-blue-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
              </div>
              <div>
                <p class="text-white-pure font-medium text-sm">Facebook</p>
                <p class="text-white-pure/50 text-xs mt-0.5">Síguenos y mantente al día</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white-pure/30 ml-auto group-hover:text-blue-500/60 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>

          </div>

          <!-- CTA destacado -->
          <div class="mt-8 space-y-4">

            <!-- Organizador masivo / alianza -->
            <div class="p-5 rounded-xl border border-orange-primary/30 bg-orange-primary/5">
              <div class="flex items-center gap-2 mb-1">
                <p class="text-orange-primary font-semibold text-sm">¿Gestionas múltiples eventos o una gran comunidad deportiva?</p>
              </div>
              <p class="text-white-pure/60 text-sm mb-4">Si coordinas varias competencias al año, representas una federación, club o empresa de timing, podemos estructurar una <span class="text-white-pure font-medium">alianza estratégica</span>: precios especiales, marca blanca, integración con tus sistemas y soporte dedicado.</p>
              <a
                href="https://wa.me/5219932069861"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-orange-primary hover:bg-red-fire text-white-pure rounded-lg transition-colors text-sm font-medium"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                </svg>
                Hablemos de una alianza
              </a>
            </div>

          </div>
        </div>

      </div>
    </main>
    <Footer />
  </body>
</html>
