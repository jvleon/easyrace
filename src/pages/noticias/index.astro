---
import NavBar from '../../components/NavBar.astro';
import NoticiasSection from '../../components/NoticiasSection';
import SentryInit from '../../components/SentryInit';
import { VersionCheckModal } from '../../components/VersionCheckModal';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Noticias del mundo deportivo: ciclismo, running, triatlón y eventos en el sureste de México." />
    <title>Noticias - EasyRace</title>
    <script is:inline src="/staging-guard.js"></script>
    <script is:inline>
      if (!window.__EASYRACE_BLOCK_ANALYTICS__) {
        var s = document.createElement('script'); s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', 'G-H98RYPYQCQ');
      }
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <NavBar />
    <main class="container mx-auto px-4 pt-10 pb-12 md:pt-14 md:pb-16 flex-1">

      <header class="mb-10 md:mb-12 text-center">
        <p class="text-orange-primary text-sm font-medium uppercase tracking-widest mb-3">Noticias</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white-pure mb-4">Lo último del mundo deportivo</h1>
        <p class="text-white-pure/60 max-w-xl mx-auto">Carreras, ciclismo, triatlón y todo lo que pasa en los eventos deportivos del sureste.</p>
      </header>

      <NoticiasSection client:load />

    </main>
    <Footer />
  </body>
</html>
