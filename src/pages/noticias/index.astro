---
import NavBar from '../../components/NavBar.astro';
import SentryInit from '../../components/SentryInit';
import { VersionCheckModal } from '../../components/VersionCheckModal';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const articles = [
  {
    title: 'Nueva temporada de ciclismo de ruta 2026',
    excerpt: 'Conoce los eventos mas importantes de ciclismo de ruta que se llevaran a cabo en el sureste mexicano durante este año.',
    date: '10 Mar 2026',
    category: 'Ciclismo',
  },
  {
    title: 'Tips para tu primera carrera de 10K',
    excerpt: 'Guia completa para prepararte y disfrutar tu primera carrera de 10 kilometros. Alimentacion, entrenamiento y logistica.',
    date: '05 Mar 2026',
    category: 'Running',
  },
  {
    title: 'EasyRace se expande a nuevos estados',
    excerpt: 'La plataforma ahora esta disponible para organizadores en toda la republica mexicana. Conoce como publicar tu evento.',
    date: '28 Feb 2026',
    category: 'Plataforma',
  },
  {
    title: 'Los mejores eventos de triatlon del sureste 2026',
    excerpt: 'Agenda completa de eventos de triatlon en Tabasco, Yucatan, Campeche y Quintana Roo para este año.',
    date: '20 Feb 2026',
    category: 'Triatlon',
  },
  {
    title: 'Como prepararte para un Gran Fondo de 100km',
    excerpt: 'Plan de entrenamiento de 12 semanas para completar tu primer Gran Fondo ciclista. Nutricion, equipamiento y estrategia.',
    date: '15 Feb 2026',
    category: 'Ciclismo',
  },
  {
    title: 'Resultados: Carrera Nocturna Villahermosa 2026',
    excerpt: 'Todos los tiempos y posiciones de la carrera nocturna de 5K y 10K celebrada en el Parque Tomas Garrido.',
    date: '08 Feb 2026',
    category: 'Resultados',
  },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Noticias del mundo deportivo: ciclismo, running, triatlon y eventos en el sureste de Mexico." />
    <title>Noticias - EasyRace</title>
    <script is:inline src="/staging-guard.js"></script>
    <script is:inline>
      if (!window.__EASYRACE_BLOCK_ANALYTICS__) {
        var s = document.createElement('script'); s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', 'G-H98RYPYQCQ');
      }
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <NavBar />
    <main class="container mx-auto px-4 pt-4 pb-12 md:pt-6 md:pb-16 flex-1">

      <header class="mb-10 md:mb-14 text-center">
        <p class="text-orange-primary text-sm font-medium uppercase tracking-widest mb-3">Noticias</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white-pure mb-4">Lo ultimo del mundo deportivo</h1>
        <p class="text-white-pure/60 max-w-xl mx-auto">Carreras, ciclismo, triatlon y todo lo que pasa en los eventos deportivos del sureste.</p>
      </header>

      <!-- TODO: Connect to CMS/Supabase when ready -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((article) => (
          <article class="rounded-xl border border-white-pure/10 bg-white-pure/5 overflow-hidden hover:border-orange-primary/30 transition-colors group">
            <div class="h-44 bg-gradient-to-br from-white-pure/10 to-white-pure/5 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white-pure/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </div>
            <div class="p-5">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-orange-primary text-xs font-medium">{article.category}</span>
                <span class="text-white-pure/30 text-xs">·</span>
                <span class="text-white-pure/40 text-xs">{article.date}</span>
              </div>
              <h2 class="text-white-pure font-bold text-base mb-2 group-hover:text-orange-primary transition-colors leading-snug">
                {article.title}
              </h2>
              <p class="text-white-pure/50 text-sm line-clamp-3">{article.excerpt}</p>
            </div>
          </article>
        ))}
      </div>

    </main>
    <Footer />
  </body>
</html>
