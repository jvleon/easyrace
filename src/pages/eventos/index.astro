---
import NavBar from '../../components/NavBar.astro';
import EventsListFiltered from '../../components/EventsListFiltered';
import SentryInit from '../../components/SentryInit';
import { VersionCheckModal } from '../../components/VersionCheckModal';
import Footer from '../../components/Footer.astro';
import ChatWidget from '../../components/chat/ChatWidget';
import '../../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="keywords" content="EasyRace, eventos deportivos, carreras, ciclismo, running, triatlon, registro eventos" />
    <meta name="author" content="Coderbox Software Solutions" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Explora todos los eventos deportivos disponibles en EasyRace. Filtra por tipo de deporte y encuentra tu próxima carrera." />
    <title>Todos los Eventos - EasyRace</title>

    <!-- Staging/Demo guard: bloquea analytics e inyecta noindex -->
    <script is:inline src="/staging-guard.js"></script>

    <!-- Google tag (gtag.js) - No se carga en staging/demo -->
    <script is:inline>
      if (!window.__EASYRACE_BLOCK_ANALYTICS__) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-H98RYPYQCQ');
      }
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <NavBar />
    <main class="container mx-auto px-4 pt-4 pb-8 md:pt-6 md:pb-12 flex-1">
      <header class="mb-8 md:mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white-pure mb-4">
          Todos los Eventos
        </h1>
      </header>

      <EventsListFiltered client:load />
    </main>
    <Footer />
    <ChatWidget client:load />
  </body>
</html>
