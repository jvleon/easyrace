---
import { supabase } from '../../lib/supabase';
import EventDetail from '../../components/EventDetail';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// Para modo estático, necesitamos generar todas las rutas en build time
// Solo generamos las rutas, los datos se cargan dinámicamente en el cliente
export async function getStaticPaths() {
  const { data: events, error } = await supabase
    .from('events')
    .select('slug')
    .in('status', ['published', 'completed'])
    .not('name', 'is', null)
    .not('date', 'is', null);

  if (error || !events) {
    return [];
  }

  return events.map((event) => ({
    params: { slug: event.slug },
  }));
}

const { slug } = Astro.params;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestion de eventos deportivos" />
    <title>Evento - EasyRace</title>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <Header />
    <main class="flex-1">
      <EventDetail slug={slug} client:load />
    </main>
    <Footer />
  </body>
</html>

