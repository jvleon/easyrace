---
import { supabase } from '../../lib/supabase';
import { formatEventDate, isRegistrationOpen } from '../../utils/dateFormatter';
import { slateToHtml } from '../../utils/slateToHtml';
import { getBannerUrl } from '../../utils/imageUrl';
import RegistrationButton from '../../components/RegistrationButton';
import Countdown from '../../components/Countdown';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// Para modo estático, necesitamos generar todas las rutas en build time
export async function getStaticPaths() {
  const { data: events, error } = await supabase
    .from('events')
    .select('slug')
    .in('status', ['published', 'completed'])
    .not('name', 'is', null)
    .not('date', 'is', null);

  if (error || !events) {
    return [];
  }

  return events.map((event) => ({
    params: { slug: event.slug },
  }));
}

const { slug } = Astro.params;

const { data: event, error } = await supabase
  .from('events')
  .select('*')
  .eq('slug', slug)
  .in('status', ['published', 'completed'])
  .single();

if (error || !event) {
  return Astro.redirect('/404');
}

// Cargar categorías del evento con sus distancias relacionadas
const { data: categories, error: categoriesError } = await supabase
  .from('categories')
  .select(`
    id,
    name,
    price,
    distance,
    gender,
    distance_id,
    event_distances (
      id,
      name,
      strava_embed_url,
      description
    )
  `)
  .eq('event_id', event.id)
  .order('name');

// Cargar todas las distancias del evento
const { data: eventDistances, error: distancesError } = await supabase
  .from('event_distances')
  .select('id, name, strava_embed_url, description')
  .eq('event_id', event.id)
  .order('name');

// Agrupar categorías por distancia
interface CategoryWithDistance {
  id: string;
  name: string;
  price: number | null;
  distance: string | null;
  gender: string | null;
  distance_id: string | null;
  event_distances: {
    id: string;
    name: string;
    strava_embed_url: string | null;
    description: string | null;
  } | null;
}

interface DistanceGroup {
  distanceId: string | null;
  distanceName: string;
  stravaEmbed: string | null;
  description: string | null;
  categories: CategoryWithDistance[];
}

const categoriesWithDistance = (categories || []) as CategoryWithDistance[];

// Crear grupos por distancia
const distanceGroups: DistanceGroup[] = [];

// Primero, agregar categorías que tienen distancia
categoriesWithDistance.forEach((category) => {
  if (category.distance_id && category.event_distances) {
    const distanceId = category.distance_id;
    let group = distanceGroups.find((g) => g.distanceId === distanceId);
    
    if (!group) {
      group = {
        distanceId,
        distanceName: category.event_distances.name,
        stravaEmbed: category.event_distances.strava_embed_url,
        description: category.event_distances.description,
        categories: [],
      };
      distanceGroups.push(group);
    }
    
    group.categories.push(category);
  }
});

// Agregar categorías sin distancia asignada a un grupo especial
const categoriesWithoutDistance = categoriesWithDistance.filter(
  (c) => !c.distance_id
);

if (categoriesWithoutDistance.length > 0) {
  distanceGroups.push({
    distanceId: null,
    distanceName: 'Otras categorías',
    stravaEmbed: null,
    description: null,
    categories: categoriesWithoutDistance,
  });
}

// Ordenar grupos por nombre de distancia
distanceGroups.sort((a, b) => {
  if (a.distanceId === null) return 1;
  if (b.distanceId === null) return -1;
  return a.distanceName.localeCompare(b.distanceName);
});

const isCompleted = event.status === 'completed';
const registrationOpen = !isCompleted && isRegistrationOpen(
  event.registration_start_date,
  event.registration_end_date
);

// Verificar si el evento aún no ha ocurrido (para mostrar cuenta regresiva)
// Nota: La comparación se hace en el cliente para evitar problemas con timezone en build time
const eventDate = event.date ? new Date(event.date) : null;
const now = new Date();
// Mostrar cuenta regresiva si el evento tiene fecha y no está completado
// La validación final se hace en el componente Countdown
const isUpcoming = eventDate && !isCompleted;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={event.description || `Evento: ${event.name}`} />
    <title>{event.name} - EasyRace</title>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <Header />
    <main class="flex-1">
      {event.banner_url && (
        <div class="w-full h-[400px] relative overflow-hidden bg-black-asphalt/30">
          <img
            src={getBannerUrl(event.banner_url)}
            alt={event.name}
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black-asphalt/50 to-transparent pointer-events-none"></div>
        </div>
      )}
      
      {/* Cuenta regresiva para eventos próximos */}
      {isUpcoming && event.date && (
        <Countdown targetDate={event.date} client:load />
      )}

      <div class="container mx-auto px-4 pt-6 pb-8 md:pt-8 md:pb-12">
        <div class="max-w-4xl mx-auto">
          <header class="mb-8">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white-pure mb-4">
              {event.name}
            </h1>
            {event.date && (
              <p class="text-white-pure/70 text-lg">
                {formatEventDate(event.date)}
              </p>
            )}
            {event.location && (
              <p class="text-white-pure/70 text-base mt-2">
                Ubicación: {event.location}
              </p>
            )}
          </header>

          <div class="mb-8 flex flex-col items-center md:items-start gap-4">
            {isCompleted ? (
              <div class="w-full md:w-auto px-8 py-3 rounded-lg font-semibold text-lg bg-white-pure/20 text-white-pure/70 text-center">
                Evento completado, gracias a los participantes
              </div>
            ) : (
              <RegistrationButton
                eventId={event.id}
                eventSlug={event.slug}
                registrationConfig={event.registration_config}
                registrationOpen={registrationOpen}
                generalPrice={event.general_price}
                currency={event.currency || 'MXN'}
                client:load
              />
            )}
          </div>

          {event.page_description && (
            <div
              class="prose prose-invert max-w-none text-white-pure mb-12"
              set:html={slateToHtml(event.page_description)}
            />
          )}

          {!event.page_description && event.description && (
            <div class="prose prose-invert max-w-none mb-12">
              <p class="text-white-pure/90 text-lg leading-relaxed">
                {event.description}
              </p>
            </div>
          )}

          {/* Sección de Distancias y Categorías */}
          {distanceGroups.length > 0 && (
            <section class="mb-12">
              <h2 class="text-2xl md:text-3xl font-bold text-white-pure mb-8">
                Distancias y Categorías
              </h2>
              <div class="space-y-12">
                {distanceGroups.map((group) => (
                  <div key={group.distanceId || 'no-distance'} class="space-y-6">
                    {/* Título de la distancia */}
                    <div class="border-b border-white-pure/20 pb-4">
                      <h3 class="text-xl md:text-2xl font-bold text-white-pure">
                        {group.distanceName}
                      </h3>
                      {group.description && (
                        <p class="text-white-pure/70 mt-2">{group.description}</p>
                      )}
                    </div>

                    {/* Strava embed de la distancia (si existe) */}
                    {group.stravaEmbed && (
                      <div class="w-full rounded-lg overflow-hidden border border-white-pure/20 bg-white-pure/5 p-4">
                        <h4 class="text-lg font-semibold text-white-pure mb-4">
                          Ruta en Strava
                        </h4>
                        <div set:html={group.stravaEmbed} />
                      </div>
                    )}

                    {/* Categorías de esta distancia */}
                    {group.categories.length > 0 && (
                      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {group.categories.map((category) => (
                          <div
                            key={category.id}
                            class="bg-white-pure/10 border border-white-pure/20 rounded-lg p-6 hover:bg-white-pure/15 transition-colors"
                          >
                            <h4 class="text-lg font-semibold text-white-pure mb-3">
                              {category.name}
                            </h4>
                            <div class="space-y-2">
                              {category.price !== null && category.price > 0 ? (
                                <p class="text-white-pure/80">
                                  <span class="font-medium">Precio:</span>{' '}
                                  ${Number(category.price).toLocaleString('es-MX', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2,
                                  })}{' '}
                                  {event.currency || 'MXN'}
                                </p>
                              ) : (
                                <p class="text-orange-primary font-medium">Gratis</p>
                              )}
                              {category.gender && (
                                <p class="text-white-pure/60 text-sm">
                                  {category.gender === 'male'
                                    ? 'Masculino'
                                    : category.gender === 'female'
                                    ? 'Femenino'
                                    : 'Mixto'}
                                </p>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

