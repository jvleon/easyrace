---
import { supabase } from '../../lib/supabase';
import EventDetail from '../../components/EventDetail';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// Ruta dinámica que genera todas las rutas de eventos en build time
// Los datos se cargan dinámicamente del lado del cliente
// Esto permite que el contenido se actualice sin rebuild, pero las rutas se generan en build time
export async function getStaticPaths() {
  try {
    const { data: events, error } = await supabase
      .from('events')
      .select('slug')
      .in('status', ['published', 'completed'])
      .not('name', 'is', null)
      .not('date', 'is', null);

    if (error || !events) {
      console.warn('Error loading events for static paths:', error);
      // Retornar array vacío - la ruta se manejará dinámicamente
      return [];
    }

    // Registrar rutas para todos los eventos existentes
    // Con prerender: false, NO se generan archivos estáticos
    // El contenido se carga dinámicamente en runtime
    return events.map((event) => ({
      params: { slug: event.slug },
    }));
  } catch (error) {
    console.error('Error in getStaticPaths:', error);
    return [];
  }
}

// Obtener el slug desde los parámetros
let { slug } = Astro.params;

// Limpiar y validar el slug
if (slug) {
  // Remover slash al final si existe
  slug = slug.replace(/\/$/, '');
  // Remover espacios en blanco
  slug = slug.trim();
  
  // Si el slug está vacío después de limpiar, redirigir a 404
  if (!slug || slug === '') {
    return Astro.redirect('/404', 404);
  }
} else {
  // Si no hay slug, redirigir a 404
  return Astro.redirect('/404', 404);
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestion de eventos deportivos" />
    <title>Evento - EasyRace</title>
    
    <link rel="preconnect" href="https://challenges.cloudflare.com">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H98RYPYQCQ');
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <Header />
    <main class="flex-1">
      <EventDetail slug={slug} client:load />
    </main>
    <Footer />
  </body>
</html>

