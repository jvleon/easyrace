---
import { supabase } from '../../lib/supabase';
import EventDetail from '../../components/EventDetail';
import SentryInit from '../../components/SentryInit';
import { VersionCheckModal } from '../../components/VersionCheckModal';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// Generar solo la página "dynamic" en build time
// Pero en desarrollo, fetchear todos los eventos para que las rutas funcionen
export async function getStaticPaths() {
  // Siempre retornar la ruta "dynamic" para producción
  const paths = [{ params: { slug: 'dynamic' } }];
  
  // En desarrollo, también generar rutas para eventos existentes
  // Esto permite que /eventos/[slug] funcione en localhost
  if (import.meta.env.DEV) {
  try {
      const { data: events } = await supabase
      .from('events')
      .select('slug')
      .in('status', ['published', 'completed'])
        .not('slug', 'is', null);

      if (events) {
        events.forEach(event => {
          paths.push({ params: { slug: event.slug } });
        });
      }
    } catch (error) {
      console.error('Error loading events for dev paths:', error);
    }
  }

    return paths;
}

// Obtener el slug desde los parámetros
const { slug } = Astro.params;

// El componente EventDetail extraerá el slug real de la URL del navegador en runtime
const cleanedSlug = slug || 'dynamic';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestion de eventos deportivos" />
    <title>Evento - EasyRace</title>
    
    <link rel="preconnect" href="https://challenges.cloudflare.com">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H98RYPYQCQ');
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <SentryInit client:load />
    <VersionCheckModal client:load />
    <Header />
    <main class="flex-1">
      <EventDetail slug={cleanedSlug} client:load />
    </main>
    <Footer />
  </body>
</html>
