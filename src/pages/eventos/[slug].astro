---
import { supabase } from '../../lib/supabase';
import EventDetail from '../../components/EventDetail';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// Ruta dinámica: generar rutas para eventos existentes + una ruta genérica
// En desarrollo: las rutas generadas funcionan directamente
// En producción: el .htaccess redirige todas las rutas a /eventos/dynamic.html
export async function getStaticPaths() {
  try {
    // Cargar todos los eventos publicados desde Supabase
    const { data: events, error } = await supabase
      .from('events')
      .select('slug')
      .in('status', ['published', 'completed'])
      .not('name', 'is', null)
      .not('date', 'is', null);

    if (error) {
      console.warn('Error loading events for static paths:', error);
    }

    // Generar rutas para todos los eventos existentes
    const eventRoutes = events?.map((event) => ({
      params: { slug: event.slug },
    })) || [];

    // Agregar la ruta genérica "dynamic" que usará el .htaccess en producción
    eventRoutes.push({
      params: { slug: 'dynamic' },
    });

    return eventRoutes;
  } catch (error) {
    console.error('Error in getStaticPaths:', error);
    // Si hay error, solo generar la ruta dynamic
    return [{ params: { slug: 'dynamic' } }];
  }
}

// Obtener el slug desde los parámetros
const { slug } = Astro.params;

// El slug será "dynamic" en build time
// El componente EventDetail extraerá el slug real de la URL del navegador en runtime
const cleanedSlug = slug || 'dynamic';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestion de eventos deportivos" />
    <title>Evento - EasyRace</title>
    
    <link rel="preconnect" href="https://challenges.cloudflare.com">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H98RYPYQCQ');
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <Header />
    <main class="flex-1">
      <EventDetail slug={cleanedSlug} client:load />
    </main>
    <Footer />
  </body>
</html>
