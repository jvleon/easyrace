---
import { supabase } from '../../lib/supabase';
import EventDetail from '../../components/EventDetail';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// Generar todas las rutas posibles en build time
// Los datos se cargan dinámicamente del lado del cliente
// Nota: Se generan rutas para todos los eventos (demo y no demo)
// La validación del subdominio se hace en runtime en el componente EventDetail
export async function getStaticPaths() {
  try {
    const { data: events, error } = await supabase
      .from('events')
      .select('slug, is_demo')
      .in('status', ['published', 'completed'])
      .not('name', 'is', null)
      .not('date', 'is', null);

    if (error || !events) {
      console.warn('Error loading events for static paths:', error);
      // Retornar una ruta genérica como fallback
      return [{ params: { slug: 'dynamic' } }];
    }

    // Generar rutas para todos los eventos existentes
    // La validación del subdominio se hace en runtime en EventDetail
    const paths = events.map((event) => ({
      params: { slug: event.slug },
    }));

    // Agregar una ruta genérica para eventos nuevos que no estén en build time
    // El componente obtendrá el slug desde la URL
    paths.push({ params: { slug: 'dynamic' } });

    return paths;
  } catch (error) {
    console.error('Error in getStaticPaths:', error);
    // Retornar una ruta genérica como fallback
    return [{ params: { slug: 'dynamic' } }];
  }
}

const { slug } = Astro.params;
// Si el slug es 'dynamic', el componente lo obtendrá de la URL
const eventSlug = slug === 'dynamic' ? undefined : slug;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="EasyRace - plataforma para gestion de eventos deportivos" />
    <title>Evento - EasyRace</title>
    
    <link rel="preconnect" href="https://challenges.cloudflare.com">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H98RYPYQCQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H98RYPYQCQ');
    </script>
  </head>
  <body class="min-h-screen bg-black-asphalt flex flex-col">
    <Header />
    <main class="flex-1 p-0 m-0 w-full">
      <EventDetail slug={eventSlug} client:load />
    </main>
    <Footer />
  </body>
</html>

